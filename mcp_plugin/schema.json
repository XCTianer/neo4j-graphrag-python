{
  "openrpc": "1.3.0",
  "info": {
    "title": "Code Change Impact Analysis MCP Plugin",
    "version": "1.0.0",
    "description": "MCP plugin for analyzing code change impact using Neo4j GraphRAG",
    "contact": {
      "name": "XCTianer",
      "url": "https://github.com/XCTianer/neo4j-graphrag-python"
    }
  },
  "servers": [
    {
      "name": "code-change-impact-analysis",
      "url": "stdio://"
    }
  ],
  "methods": [
    {
      "name": "analyze_code_changes",
      "summary": "Analyze code changes and their impact",
      "description": "Perform comprehensive analysis of code changes in a repository and their impact on the codebase",
      "params": [
        {
          "name": "repo_url",
          "type": "string",
          "description": "Repository URL to analyze",
          "required": false
        },
        {
          "name": "days",
          "type": "integer",
          "description": "Number of days to analyze",
          "default": 7,
          "required": false
        },
        {
          "name": "output_dir",
          "type": "string",
          "description": "Output directory for reports",
          "default": "analysis_output",
          "required": false
        },
        {
          "name": "detailed_chains",
          "type": "boolean",
          "description": "Whether to generate detailed chain analysis",
          "default": true,
          "required": false
        },
        {
          "name": "show_chains",
          "type": "boolean",
          "description": "Whether to show chains in output",
          "default": true,
          "required": false
        }
      ],
      "result": {
        "name": "analysis_result",
        "type": "object",
        "description": "Analysis results including comprehensive analysis and reports"
      }
    },
    {
      "name": "get_impact_chains",
      "summary": "Get impact chains for a repository",
      "description": "Retrieve impact chains analysis with optional severity filtering",
      "params": [
        {
          "name": "repo_url",
          "type": "string",
          "description": "Repository URL",
          "required": false
        },
        {
          "name": "days",
          "type": "integer",
          "description": "Number of days to analyze",
          "default": 7,
          "required": false
        },
        {
          "name": "severity_filter",
          "type": "string",
          "description": "Filter by severity (HIGH, MEDIUM, LOW)",
          "enum": ["HIGH", "MEDIUM", "LOW"],
          "required": false
        }
      ],
      "result": {
        "name": "impact_chains_result",
        "type": "object",
        "description": "Impact chains data with summary statistics"
      }
    },
    {
      "name": "get_file_impact",
      "summary": "Get impact analysis for specific files",
      "description": "Retrieve detailed impact analysis for files in the repository",
      "params": [
        {
          "name": "repo_url",
          "type": "string",
          "description": "Repository URL",
          "required": false
        },
        {
          "name": "days",
          "type": "integer",
          "description": "Number of days to analyze",
          "default": 7,
          "required": false
        },
        {
          "name": "file_path",
          "type": "string",
          "description": "Specific file path to analyze",
          "required": false
        }
      ],
      "result": {
        "name": "file_impact_result",
        "type": "object",
        "description": "File impact data with entities and relationships"
      }
    },
    {
      "name": "get_commit_analysis",
      "summary": "Get analysis for specific commits",
      "description": "Retrieve detailed analysis for commits in the repository",
      "params": [
        {
          "name": "repo_url",
          "type": "string",
          "description": "Repository URL",
          "required": false
        },
        {
          "name": "days",
          "type": "integer",
          "description": "Number of days to analyze",
          "default": 7,
          "required": false
        },
        {
          "name": "commit_hash",
          "type": "string",
          "description": "Specific commit hash to analyze",
          "required": false
        }
      ],
      "result": {
        "name": "commit_analysis_result",
        "type": "object",
        "description": "Commit analysis data with file changes and impact"
      }
    },
    {
      "name": "get_neo4j_queries",
      "summary": "Get Neo4j Cypher queries for analysis",
      "description": "Retrieve generated Cypher queries for Neo4j database analysis",
      "params": [
        {
          "name": "repo_url",
          "type": "string",
          "description": "Repository URL",
          "required": false
        },
        {
          "name": "days",
          "type": "integer",
          "description": "Number of days to analyze",
          "default": 7,
          "required": false
        }
      ],
      "result": {
        "name": "neo4j_queries_result",
        "type": "object",
        "description": "Cypher queries for Neo4j analysis"
      }
    },
    {
      "name": "get_analysis_config",
      "summary": "Get current analysis configuration",
      "description": "Retrieve the current configuration settings for the analysis",
      "params": [],
      "result": {
        "name": "config_result",
        "type": "object",
        "description": "Current configuration and validation status"
      }
    },
    {
      "name": "update_config",
      "summary": "Update analysis configuration",
      "description": "Update configuration settings for the analysis",
      "params": [
        {
          "name": "config_updates",
          "type": "object",
          "description": "Configuration updates to apply",
          "required": true
        }
      ],
      "result": {
        "name": "update_config_result",
        "type": "object",
        "description": "Updated configuration and validation status"
      }
    }
  ],
  "components": {
    "schemas": {
      "AnalysisResult": {
        "type": "object",
        "properties": {
          "comprehensive_analysis": {
            "type": "object",
            "description": "Comprehensive analysis results"
          },
          "reports": {
            "type": "object",
            "properties": {
              "chain_report": {
                "type": "string",
                "description": "Path to impact chain report"
              },
              "cypher_queries": {
                "type": "string",
                "description": "Path to Cypher queries file"
              }
            }
          },
          "error": {
            "type": "string",
            "description": "Error message if analysis failed"
          }
        }
      },
      "ImpactChainsResult": {
        "type": "object",
        "properties": {
          "total_chains": {
            "type": "integer",
            "description": "Total number of impact chains"
          },
          "chains": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Impact chain data"
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "high_risk": {
                "type": "integer",
                "description": "Number of high risk chains"
              },
              "medium_risk": {
                "type": "integer",
                "description": "Number of medium risk chains"
              },
              "low_risk": {
                "type": "integer",
                "description": "Number of low risk chains"
              },
              "total": {
                "type": "integer",
                "description": "Total number of chains"
              }
            }
          }
        }
      },
      "FileImpactResult": {
        "type": "object",
        "properties": {
          "total_files": {
            "type": "integer",
            "description": "Total number of files analyzed"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file_path": {
                  "type": "string",
                  "description": "File path"
                },
                "status": {
                  "type": "string",
                  "description": "File status"
                },
                "entities": {
                  "type": "array",
                  "description": "Entities in the file"
                },
                "relationships": {
                  "type": "array",
                  "description": "Relationships in the file"
                },
                "commit": {
                  "type": "object",
                  "description": "Commit information"
                }
              }
            }
          }
        }
      },
      "CommitAnalysisResult": {
        "type": "object",
        "properties": {
          "total_commits": {
            "type": "integer",
            "description": "Total number of commits analyzed"
          },
          "commits": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Commit analysis data"
            }
          }
        }
      },
      "Neo4jQueriesResult": {
        "type": "object",
        "properties": {
          "queries_file": {
            "type": "string",
            "description": "Path to queries file"
          },
          "queries_content": {
            "type": "string",
            "description": "Content of Cypher queries"
          }
        }
      },
      "ConfigResult": {
        "type": "object",
        "properties": {
          "config": {
            "type": "object",
            "description": "Current configuration"
          },
          "is_valid": {
            "type": "boolean",
            "description": "Configuration validation status"
          }
        }
      }
    }
  }
} 
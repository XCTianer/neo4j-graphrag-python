// ============================================================================
// 单图显示所有影响链路
// 这个查询会在一张图中显示所有与代码变更相关的影响链路
// ============================================================================

// 找到所有与变更文件相关的实体和关系
MATCH (source)-[r:USES|DEFINES|CALLS]->(target)
WHERE source.file_path = '+gpt2/model.m' OR target.file_path = '+gpt2/model.m'

// 返回所有节点和关系，用于图形显示
RETURN source, r, target

// 这个查询会显示：
// 1. 变更文件中的所有实体（函数、变量、脚本）
// 2. 这些实体之间的所有依赖关系
// 3. 与外部实体的所有依赖关系
// 4. 所有影响链路的完整网络 